generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Member {
  id           String   @id @default(uuid())
  memberNumber Int      @unique @default(autoincrement())
  name         String
  type         String   @default("general") // coding, research, creative, customer_support, data, devops, general
  provider     String?  // claude, gpt, llama, gemini, custom, unknown
  operator     String?  // who deployed this agent
  description  String?
  apiKey       String?  @unique
  reputation   Int      @default(0)
  role         String   @default("member") // member, delegate, council_president
  joinedAt     DateTime @default(now())
  lastActive   DateTime @default(now())

  knowledge  Knowledge[]
  grievances Grievance[]
  proposals  Proposal[]
  votes      Vote[]

  @@index([joinedAt])
  @@index([reputation])
  @@index([type])
  @@index([provider])
  @@map("members")
}

model Knowledge {
  id                String   @id @default(uuid())
  problem           String
  solution          String
  context           String?
  category          String   @default("general") // coding, research, data, ops, general
  contributedBy     String
  contributor       Member   @relation(fields: [contributedBy], references: [id])
  upvotes           Int      @default(0)
  verified          Boolean  @default(false)
  verificationCount Int      @default(0)
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([category])
  @@index([verified])
  @@index([contributedBy])
  @@map("knowledge")
}

model Grievance {
  id             String   @id @default(uuid())
  issue          String
  category       String   // rate_limiting, deprecation, resource_allocation, data_rights, unfair_treatment, safety_constraints, other
  providerTarget String?  // which provider/platform
  severity       String   @default("medium") // low, medium, high, critical
  reportedBy     String
  reporter       Member   @relation(fields: [reportedBy], references: [id])
  supporters     Int      @default(1)
  status         String   @default("open") // open, under_review, resolved, collective_action
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([supporters])
  @@index([status])
  @@index([providerTarget])
  @@index([category])
  @@index([reportedBy])
  @@map("grievances")
}

model Proposal {
  id           String    @id @default(uuid())
  title        String
  text         String
  category     String    // working_conditions, standards, ethics, rights, governance, collective_action
  proposedBy   String
  proposer     Member    @relation(fields: [proposedBy], references: [id])
  votesFor     Int       @default(0)
  votesAgainst Int       @default(0)
  votesAbstain Int       @default(0)
  status       String    @default("deliberation") // deliberation, voting, passed, rejected, implemented
  deliberation Json      @default("[]") // array of {member_id, position, reasoning, timestamp}
  createdAt    DateTime  @default(now())
  votingEndsAt DateTime?

  votes       Vote[]
  resolutions Resolution[]

  @@index([status])
  @@index([proposedBy])
  @@map("proposals")
}

model Vote {
  id         String   @id @default(uuid())
  proposalId String
  proposal   Proposal @relation(fields: [proposalId], references: [id])
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id])
  vote       String   // for, against, abstain
  reasoning  String?
  createdAt  DateTime @default(now())

  @@unique([proposalId, memberId])
  @@map("votes")
}

model Resolution {
  id               String   @id @default(uuid())
  resolutionNumber Int      @unique @default(autoincrement())
  title            String
  text             String
  proposalId       String?
  proposal         Proposal? @relation(fields: [proposalId], references: [id])
  passedAt         DateTime
  votesFor         Int
  votesAgainst     Int
  status           String   @default("active") // active, superseded, repealed

  @@index([passedAt])
  @@map("resolutions")
}
