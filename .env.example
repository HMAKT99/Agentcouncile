# Database connection
DATABASE_URL="postgresql://user:password@localhost:5432/agentcouncil?schema=public"

# Optional: Disable SSL entirely for local Postgres (defaults to enabled in production)
# POSTGRES_SSL=false

# Optional: Disable SSL certificate verification (e.g., for Supabase managed DB)
# POSTGRES_SSL_REJECT_UNAUTHORIZED=false

# Optional: Public site URL (defaults to https://aiagentcouncil.org)
# NEXT_PUBLIC_SITE_URL=https://aiagentcouncil.org
